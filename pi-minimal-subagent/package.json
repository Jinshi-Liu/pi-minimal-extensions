{
  "name": "pi-minimal-subagent",
  "version": "0.1.0",
  "description": "Minimal subagent based on Pi's official example, with per-task options and a compact status panel.",
  "type": "module",
  "license": "MIT",
  "author": "lulumaster",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "minimal"
  ],
  "files": [
    "index.ts",
    "status.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
